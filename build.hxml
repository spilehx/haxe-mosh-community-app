-lib haxeui-core
-lib haxeui-html5
-lib heaps

-cp src
-main Main
-js ../PROJECT_OUTPUT/js/app.js

## copy assets to dist folder
--cmd cp -r ./assets/. ../PROJECT_OUTPUT/